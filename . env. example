# ─────────────────────────────────────────
# Campus Intelligence System — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────

# PostgreSQL Database (get free DB from https://supabase.com)
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/cis_db

# NextAuth Secret (generate any random string)
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Twilio SMS (get from https://twilio.com - free trial)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Push Notifications (get from https://firebase.google.com)
FIREBASE_SERVER_KEY=your_firebase_key

# App Config
NEXT_PUBLIC_APP_NAME=Campus Intelligence System
NEXT_PUBLIC_COLLEGE_NAME=Sairam College of Engineering
ALERT_WINDOW_MINUTES=30
